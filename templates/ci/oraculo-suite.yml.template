# Export ONLY to a reviewed, sanitized public checkout. This file is inactive.
name: CI

on:
  workflow_dispatch:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  basic:
    name: Basic checks
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          python-version: "3.12"
      - run: uv sync --frozen
      - run: uv run --frozen ruff check src tests scripts
      - run: uv run --frozen python scripts/validate_ci_exports.py
      - name: Basic regression tests
        run: uv run --frozen pytest -q tests/test_protocol.py tests/test_config.py tests/test_cli.py tests/test_ci_azure.py --junitxml="$RUNNER_TEMP/basic-results.xml"
      - name: Preserve basic results
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: basic-results-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/basic-results.xml
          if-no-files-found: warn
          retention-days: 7
