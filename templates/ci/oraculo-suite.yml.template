# Export ONLY to a reviewed, sanitized public checkout. This file is inactive.
name: CI

on:
  workflow_dispatch:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  tests:
    name: Tests (${{ matrix.os }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: ${{ matrix.timeout }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
        # Preserve required check names while selecting the actual runner pool.
        # ARM64 hosted jobs repeatedly expired before any runner was allocated.
        include:
          - os: ubuntu-latest
            runner: ubuntu-latest
            # The complete serial CLI/Git suite exceeded 30 minutes on Linux too.
            timeout: 120
          - os: macos-latest
            runner: macos-26-intel
            # Serial CLI/Git integration tests exceeded the old 30-minute job.
            timeout: 120
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "0.13.1"
          python-version: "3.12"
      - run: uv sync --frozen
      - run: uv run --frozen ruff check src tests scripts
      - run: uv run --frozen python scripts/validate_ci_exports.py
      - name: Complete suite
        run: uv run --frozen pytest -v --durations=25 --junitxml="$RUNNER_TEMP/pytest-results.xml"
      - name: Preserve pytest results
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: pytest-results-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.os }}
          path: ${{ runner.temp }}/pytest-results.xml
          # Missing JUnit after cancellation warns; the job failure stays intact.
          if-no-files-found: warn
          retention-days: 7
