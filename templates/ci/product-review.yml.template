# Export ONLY to a reviewed, sanitized public checkout. This file is inactive.
name: Oraculo product review
on:
  workflow_dispatch:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  product-review:
    name: Product review (exact HEAD)
    runs-on: ubuntu-24.04
    # The complete serial scenario set took 36m29s before a 40m evaluation timeout.
    # Leave room for the bounded evaluator and always-uploaded evidence.
    timeout-minutes: 100
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      UV_PYTHON_DOWNLOADS: never
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e # v10.3.2
        with:
          version: '0.13.1'
          enable-cache: false
      - run: uv sync --frozen --group dev
      - name: Prepare product review receipt
        id: proof
        shell: bash
        run: |
          evidence_dir="$(mktemp -d)"
          printf 'path=%s\n' "$evidence_dir/product-review" >> "$GITHUB_OUTPUT"
          printf 'name=product-review-%s-%s-%s\n' "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
      - name: Evaluate product journeys and operation invariants
        shell: bash
        run: |
          uv run --frozen python -B scripts/review_product_eval.py --expect-head "$(git rev-parse HEAD)" --output "${{ steps.proof.outputs.path }}"
      - name: Preserve requirement scenario proof result matrix
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ${{ steps.proof.outputs.name }}
          path: ${{ steps.proof.outputs.path }}
          if-no-files-found: error
          retention-days: 7
