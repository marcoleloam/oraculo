# Export ONLY to a reviewed, sanitized public checkout. This file is inactive.
name: Oraculo offline validation
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  offline:
    name: Orchestration offline gate
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      UV_PYTHON_DOWNLOADS: never
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e # v10.3.2
        with:
          version: '0.13.1'
          enable-cache: false
      - name: Prepare inspectable evidence
        id: proof
        shell: bash
        run: |
          evidence_dir="$(mktemp -d)"
          printf 'path=%s\n' "$evidence_dir/receipt" >> "$GITHUB_OUTPUT"
          printf 'name=offline-%s-%s-%s\n' "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" "$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
      - name: Offline exact-source gate
        shell: bash
        run: |
          python -B scripts/orchestration_ci.py --expect-head "$(git rev-parse HEAD)" --output "${{ steps.proof.outputs.path }}" --run-id "$GITHUB_RUN_ID" --run-attempt "$GITHUB_RUN_ATTEMPT"
      - name: Preserve positive and negative evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: ${{ steps.proof.outputs.name }}
          path: ${{ steps.proof.outputs.path }}
          if-no-files-found: error
          retention-days: 7
  # GUI/launchd tests require a separate, explicitly authorized macOS runner.
  # They remain pending; no skip or synthetic observation certifies real launchd.
